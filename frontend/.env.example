# Frontend settings (Vite). Copy to .env.development.local — never commit real values.
# Only VITE_ variables reach the browser bundle, so NEVER put the LLM / OpenAI key here.
# The model key lives only in the backend's .env (project root).

# Base URL of Developer C's Python API, e.g. http://localhost:8000
VITE_API_BASE_URL=

# true  = use the synthetic in-browser mock API (default while C's API is being built)
# false = call VITE_API_BASE_URL
VITE_USE_MOCK=true
