{
  "owner": "Developer A (Ralph)",
  "about": "Checkable extraction/retrieval cases on the real package. Sanitised: file stems and order numbers only. Run: python -m backend.unstructured.evals. PENDING = the output it needs is not built yet. Updated 17 Nov for the client's answers Q01-Q08 (guide received; April card applies retrospectively; upper weight limit inclusive; no POD after 1 Feb). E may fold these into the team runner. A-E19..A-E21 (17 Nov) test the vector index (local TF-IDF embeddings, built by python -m backend.unstructured.build_index): typo tolerance and no-guess on unrelated questions. Known limit, not a case yet: pure synonyms ('smashed' = damaged, 'super kind' = polite) need the API embedding model; retest when the team key has credit.",
  "cases": [
    {
      "id": "A-E01",
      "trap": "T-A18",
      "title": "Late-delivery email gets the guide's late-delivery rule, cited to its row (client Q01/Q02)",
      "needs": "policy_chunks.jsonl",
      "call": "search_policy",
      "args": {
        "category": "late"
      },
      "expect": [
        {
          "path": "status",
          "equals": "found"
        },
        {
          "path": "data.0.heading",
          "equals": "Late delivery"
        },
        {
          "path": "data.0.citation.locator",
          "startswith": "sheet:Resolution Guide|row:"
        },
        {
          "path": "data.0.authority",
          "contains": "Q02"
        }
      ]
    },
    {
      "id": "A-E02",
      "trap": "T-A06",
      "title": "Kill-shot order 22574 finds its complaint email with a citation",
      "needs": "emails.jsonl",
      "call": "search_emails",
      "args": {
        "order_number": "22574"
      },
      "expect": [
        {
          "path": "status",
          "equals": "found"
        },
        {
          "path": "sources",
          "contains": "email:2026-06-19_014"
        },
        {
          "path": "data.0.citation.locator",
          "startswith": "body:char:"
        }
      ]
    },
    {
      "id": "A-E03",
      "trap": "T-A04",
      "title": "Compliment is not counted as a complaint",
      "needs": "emails.jsonl",
      "call": "email_record",
      "args": {
        "source_id": "email:2026-03-25_005"
      },
      "expect": [
        {
          "path": "category",
          "equals": "compliment"
        },
        {
          "path": "is_complaint",
          "equals": false
        }
      ]
    },
    {
      "id": "A-E04",
      "trap": "-",
      "title": "Unknown order number -> not_found, not a guess",
      "needs": "emails.jsonl",
      "call": "search_emails",
      "args": {
        "order_number": "99999"
      },
      "expect": [
        {
          "path": "status",
          "equals": "not_found"
        },
        {
          "path": "ok",
          "equals": true
        }
      ]
    },
    {
      "id": "A-E05",
      "trap": "-",
      "title": "Every email and the guide get a visible outcome",
      "needs": "manifest.json",
      "call": "ingest_manifest",
      "args": {},
      "expect": [
        {
          "path": "summary.emails.files",
          "equals": 90
        },
        {
          "path": "summary.emails.status.ok",
          "equals": 90
        },
        {
          "path": "summary.policy.status.ok",
          "equals": 1
        },
        {
          "path": "summary.policy.chunks",
          "equals": 12
        },
        {
          "path": "files",
          "length": 91
        }
      ]
    },
    {
      "id": "A-E06",
      "trap": "T-A02",
      "title": "Email passes number + date so B can rule out orders created later",
      "needs": "emails.jsonl",
      "call": "email_record",
      "args": {
        "source_id": "email:2026-03-09_019"
      },
      "expect": [
        {
          "path": "order_numbers",
          "equals": [
            "32460"
          ]
        },
        {
          "path": "received_at",
          "startswith": "2026-03-09"
        },
        {
          "path": "system_hint",
          "equals": null
        }
      ]
    },
    {
      "id": "A-E07",
      "trap": "T-A12/T-A13",
      "title": "POD date read day-first despite the I/1 look-alike, and matches SQL",
      "needs": "pod_records.jsonl",
      "call": "pod_record",
      "args": {
        "source_id": "pod:v1:24377"
      },
      "expect": [
        {
          "path": "fields.delivered_at.value",
          "startswith": "2025-11-18T"
