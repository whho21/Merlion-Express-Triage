{
  "owner": "Developer A (Ralph)",
  "about": "Checkable extraction/retrieval cases on the real package. Sanitised: file stems and order numbers only. Run: python -m backend.unstructured.evals. PENDING = the output it needs is not built yet (e.g. before the paid image run). D may fold these into the team runner.",
  "cases": [
    {"id": "A-E01", "trap": "T-A18", "title": "Missing Resolution Guide -> honest refusal, no invented policy",
     "needs": "manifest.json", "call": "search_policy", "args": {"query": "should we refund a lost parcel"},
     "expect": [{"path": "status", "equals": "failed"}, {"path": "error.code", "equals": "SOURCE_MISSING"}]},
    {"id": "A-E02", "trap": "T-A06", "title": "Kill-shot order 22574 finds its complaint email with a citation",
     "needs": "emails.jsonl", "call": "search_emails", "args": {"order_number": "22574"},
     "expect": [{"path": "status", "equals": "found"}, {"path": "sources", "contains": "email:2026-06-19_014"},
                {"path": "data.0.citation.locator", "startswith": "body:char:"}]},
    {"id": "A-E03", "trap": "T-A04", "title": "Compliment is not counted as a complaint",
     "needs": "emails.jsonl", "call": "email_record", "args": {"source_id": "email:2026-03-25_005"},
     "expect": [{"path": "category", "equals": "compliment"}, {"path": "is_complaint", "equals": false}]},
    {"id": "A-E04", "trap": "-", "title": "Unknown order number -> not_found, not a guess",
     "needs": "emails.jsonl", "call": "search_emails", "args": {"order_number": "99999"},
     "expect": [{"path": "status", "equals": "not_found"}, {"path": "ok", "equals": true}]},
    {"id": "A-E05", "trap": "-", "title": "Every email and the missing guide get a visible outcome",
     "needs": "manifest.json", "call": "ingest_manifest", "args": {},
     "expect": [{"path": "summary.emails.files", "equals": 90}, {"path": "summary.emails.status.ok", "equals": 90},
                {"path": "summary.policy.issues.SOURCE_MISSING", "equals": 1}, {"path": "files", "length": 91}]},
    {"id": "A-E06", "trap": "T-A02", "title": "Email passes number + date so B can rule out orders created later",
     "needs": "emails.jsonl", "call": "email_record", "args": {"source_id": "email:2026-03-09_019"},
     "expect": [{"path": "order_numbers", "equals": ["32460"]}, {"path": "received_at", "startswith": "2026-03-09"},
                {"path": "system_hint", "equals": null}]},
    {"id": "A-E07", "trap": "T-A12/T-A13", "title": "POD date read day-first despite the I/1 look-alike, and matches SQL",
     "needs": "pod_records.jsonl", "call": "pod_record", "args": {"source_id": "pod:v1:24377"},
     "expect": [{"path": "fields.delivered_at.value", "startswith": "2025-11-18T"},
                {"path": "validation.matches_sql.delivered_at", "equals": true}]},
    {"id": "A-E08", "trap": "T-A05", "title": "No POD for the v2 order 22574 (never reuse the v1 card)",
     "needs": "pod_records.jsonl", "call": "find_pod", "args": {"source_system": "v2", "order_id": 22574},
     "expect": [{"path": "status", "equals": "not_found"}]},
    {"id": "A-E09", "trap": "T-A08", "title": "POD cash-on-delivery conflict with SQL is flagged",
     "needs": "pod_records.jsonl", "call": "pod_record", "args": {"source_id": "pod:v1:24002"},
     "expect": [{"path": "flags", "contains": "cod_conflict_with_sql"}]},
    {"id": "A-E10", "trap": "T-A15", "title": "Rate for a date before the only card -> not_found",
     "needs": "rate_cards.jsonl", "call": "lookup_rate", "args": {"zone": "Central", "weight_kg": 2.0, "on_date": "2026-01-15"},
     "expect": [{"path": "status", "equals": "not_found"}]},
    {"id": "A-E11", "trap": "T-A16", "title": "10.00 kg sits on two bands -> ambiguous with both citations",
     "needs": "rate_cards.jsonl", "call": "lookup_rate", "args": {"zone": "Central", "weight_kg": 10.0, "on_date": "2026-05-01"},
     "expect": [{"path": "status", "equals": "ambiguous"}, {"path": "data", "length": 2}]},
    {"id": "A-E12", "trap": "T-A05", "title": "Every POD card is a v1 order and the key fields match SQL",
     "needs": "image_manifest.json", "call": "image_manifest", "args": {},
     "expect": [{"path": "summary.pod.images", "equals": 80}, {"path": "summary.pod.all_key_fields_match_sql", "equals": 80}]}
  ]
}
