        <mxCell id="client-pricing-rules" value="&lt;div style=&quot;font-family:'IBM Plex Sans','Helvetica Neue',Arial,sans-serif;text-align:center;line-height:1.2;color:#1A1B1C;&quot;&gt;&lt;div style=&quot;font-size:22px;font-weight:600;&quot;&gt;Client clarifications · Q06–Q08 + guide&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:400;margin-top:6px;&quot;&gt;April card for all supplied orders; cite retrospective authority.&lt;br/&gt;Inclusive 3 / 10 / 25 kg; standard service; code checks GST / CBD / PH.&lt;br/&gt;Refer unconfirmed attempt charges. Recommend; never execute refunds.&lt;br/&gt;&amp;gt;S$50 refunds / corporate 3+ complaints per month → Head of CX.&lt;/div&gt;&lt;/div&gt;" style="rounded=0;shadow=0;strokeWidth=1.5;strokeColor=#1A1B1C;fontColor=#1A1B1C;fontFamily=Helvetica Neue;fontSize=20;whiteSpace=wrap;html=1;fillColor=#F0F0C0;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
