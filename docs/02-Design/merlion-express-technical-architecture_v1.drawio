        <mxCell id="client-evidence-rules" value="&lt;div style=&quot;font-family:'IBM Plex Sans','Helvetica Neue',Arial,sans-serif;text-align:center;line-height:1.2;color:#1A1B1C;&quot;&gt;&lt;div style=&quot;font-size:22px;font-weight:600;&quot;&gt;Client clarifications · Q01–Q05&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:400;margin-top:6px;&quot;&gt;One complaint per case; retain duplicate lineage + unknown attribution.&lt;br/&gt;Guide v2 for every case; five address-derived operations zones ≠ price zones.&lt;br/&gt;No post-migration POD in supplied data; latest delivery attempt only.&lt;br/&gt;GPS Unix seconds; ops time SGT; investigate residual clock offsets.&lt;/div&gt;&lt;/div&gt;" style="rounded=0;shadow=0;strokeWidth=1.5;strokeColor=#1A1B1C;fontColor=#1A1B1C;fontFamily=Helvetica Neue;fontSize=20;whiteSpace=wrap;html=1;fillColor=#F0F0C0;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="48" y="1390" width="920" height="180" as="geometry" />
